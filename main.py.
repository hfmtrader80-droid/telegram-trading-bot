from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup
)
from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    ContextTypes
)

TOKEN = "MASUKKAN_BOT_TOKEN_ANDA"

CHANNEL = "@nama_channel_anda"
GROUP = "@nama_grup_anda"

ADMIN_ID = 123456789


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):

    keyboard = [
        [
            InlineKeyboardButton(
                "✅ Saya Sudah Join",
                callback_data="verify"
            )
        ]
    ]

    text = f"""
👋 Selamat datang di Jetmi Forex Academy

Silakan join terlebih dahulu:

📢 {CHANNEL}

👥 {GROUP}

Setelah selesai tekan tombol di bawah.
"""

    await update.message.reply_text(
        text,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )


async def verify(update: Update, context: ContextTypes.DEFAULT_TYPE):

    query = update.callback_query

    await query.answer()

    keyboard = [
        [
            InlineKeyboardButton("📚 Edukasi", callback_data="edu")
        ],
        [
            InlineKeyboardButton("💎 VVIP", callback_data="vip")
        ],
        [
            InlineKeyboardButton("☎️ Admin", url="https://t.me/username_admin")
        ]
    ]

    await query.message.edit_text(
        "✅ Verifikasi berhasil.\n\nSilakan pilih menu.",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )


async def menu(update: Update, context: ContextTypes.DEFAULT_TYPE):

    query = update.callback_query

    await query.answer()

    if query.data == "edu":
        await query.message.reply_text(
            """📚 Materi Edukasi

1. Dasar Forex
2. Candlestick
3. Support Resistance
4. Risk Management
5. Market Structure
"""
        )

    elif query.data == "vip":
        await query.message.reply_text(
            """💎 Menu VVIP

Anda belum memiliki akses.

Hubungi Admin untuk upgrade.
"""
        )


app = Application.builder().token(TOKEN).build()

app.add_handler(CommandHandler("start", start))

app.add_handler(CallbackQueryHandler(verify, pattern="verify"))

app.add_handler(CallbackQueryHandler(menu))

print("Bot berjalan...")

app.run_polling()
